rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Funciones
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isSignedIn() { return request.auth != null; }

    // Users
    function isValidUser(data) {
      return data.keys().hasAny(['email', 'role']) &&
             data.email is string && data.email.size() > 0 && data.email.size() <= 200 &&
             data.role in ['client', 'planner', 'admin'] &&
             (data.keys().hasAll(['createdAt']) ? (data.createdAt is number) : true);
    }

    match /users/{userId} {
      allow read: if isSignedIn() && request.auth.uid == userId;
      allow create: if isSignedIn() && request.auth.uid == userId && isValidUser(incoming());
      allow update: if isSignedIn() && request.auth.uid == userId && isValidUser(incoming());
    }

    // Planners
    function isValidPlanner(data) {
       return data.keys().hasAll(['userId', 'businessName']) &&
              data.userId == request.auth.uid &&
              data.businessName is string && data.businessName.size() <= 200;
    }

    match /planners/{plannerId} {
      allow read: if isSignedIn() && existing().userId == request.auth.uid;
      allow create: if isSignedIn() && isValidId(plannerId) && isValidPlanner(incoming());
      allow update: if isSignedIn() && existing().userId == request.auth.uid && isValidPlanner(incoming());
    }

    // Events
    function isValidEvent(data) {
      return data.keys().hasAll(['ownerId', 'title', 'type']) &&
             data.ownerId == request.auth.uid &&
             data.title is string && data.title.size() > 0 && data.title.size() <= 200 &&
             data.type is string && data.type.size() > 0 && data.type.size() <= 100;
    }

    match /events/{eventId} {
      allow read: if isSignedIn() && existing().ownerId == request.auth.uid;
      allow create: if isSignedIn() && isValidId(eventId) && isValidEvent(incoming());
      allow update: if isSignedIn() && existing().ownerId == request.auth.uid && isValidEvent(incoming());
      allow delete: if isSignedIn() && existing().ownerId == request.auth.uid;
    }

    // Invitations
    function isValidInvitation(data) {
       return data.keys().hasAll(['eventId', 'guestName', 'qrCode', 'ticketCount']) &&
              data.eventId is string && data.guestName is string && data.guestName.size() > 0 && data.guestName.size() <= 200 &&
              data.qrCode is string && data.qrCode.size() > 0 && data.qrCode.size() <= 128 &&
              data.ticketCount is number;
    }

    match /invitations/{invitationId} {
      allow read: if true; 
      allow create: if isSignedIn() && isValidId(invitationId) && isValidInvitation(incoming());
      allow update: if true; 
    }

    match /templates/{templateId} {
      allow read: if true;
    }

    match /aiSessions/{sessionId} {
      allow read: if isSignedIn() && existing().userId == request.auth.uid;
      allow create: if isSignedIn() && incoming().userId == request.auth.uid;
      allow update: if isSignedIn() && existing().userId == request.auth.uid;
    }
  }
}
